# IndsatsBrief core
FLASK_SECRET_KEY=change-me
BRIEF_ACCESS_CODE=
APP_BASE_URL=https://indsatsbrief.example.dk
DATABASE_URL=postgresql://indsatsbrief:change-me@postgres:5432/indsatsbrief
MAX_UPLOAD_BYTES=27262976

# Authentication / admin
ADMIN_APPROVAL_REQUIRED=true
ADMIN_EMAIL=admin@example.dk
ADMIN_NOTIFY_EMAIL=admin@example.dk
CONTACT_EMAIL=admin@example.dk
SHOW_CODE_LOGIN=false

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# Primary BBR source
DANSKADRESSE_API_KEY=
DANSKADRESSE_API_BASE=https://api.danskadresseapi.dk/v1
DANSKADRESSE_BBR_CACHE_TTL_SECONDS=86400
DANSKADRESSE_FALLBACK_TO_DATAFORDELER=true
DANSKADRESSE_INCLUDE=bbr,dagi,dar,jordstykke

# Safety-critical asbestos check across all BBR buildings on the address
DANSKADRESSE_ASBEST_ALL_BUILDINGS=true
DANSKADRESSE_ASBEST_CACHE_TTL_SECONDS=86400

# Public-data caches (seconds)
ADDRESS_CACHE_TTL_SECONDS=3600
WEATHER_CACHE_TTL_SECONDS=300
HYDRANT_CACHE_TTL_SECONDS=900
OSM_RISK_CACHE_TTL_SECONDS=900

# Optional Datafordeler fallback
DATAFORDELER_API_KEY=

# Reverse proxy / session
TRUST_PROXY_HEADERS=true
SESSION_COOKIE_SECURE=true

# SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
